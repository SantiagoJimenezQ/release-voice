# Optional. Use public to preview the hosted demo on localhost. Vercel enables it automatically.
RELEASE_VOICE_MODE=

# Optional for live drafting. Set both on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Required alongside OpenRouter for live drafting in public mode.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local mode only. Enables live mailbox reads and LinkedIn draft saves.
ZERNIO_API_KEY=

# Optional. Pin an account when more than one connected account is present.
LAUNCH_NOTES_LINKEDIN_ACCOUNT_ID=
LAUNCH_NOTES_MAIL_ACCOUNT_ID=
